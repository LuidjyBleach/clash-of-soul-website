{
  "name": "clash-of-soul-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build && tsx scripts/verify-public-build.ts",
    "build:review": "npm run typecheck && vite build --mode review",
    "preview:review": "vite preview --mode review --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "refresh-releases": "tsx scripts/refresh-releases.ts",
    "test:browser": "tsx scripts/browser-qa.ts",
    "test:performance": "tsx scripts/performance.ts",
    "test:security": "tsx scripts/security-check.ts"
  },
  "dependencies": {"react": "^19.2.0", "react-dom": "^19.2.0"},
  "devDependencies": {"@types/node": "^24.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.1.0", "@playwright/test": "^1.56.0", "@axe-core/playwright": "^4.10.0", "lighthouse": "^13.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.2.0"}
}
